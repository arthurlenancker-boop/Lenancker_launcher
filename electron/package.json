{
  "name": "lenancker-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Lenancker Launcher — packaging Windows (.exe) via Electron + electron-builder. Le site web statique est embarqué tel quel.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lenancker.launcher",
    "productName": "Lenancker Launcher",
    "copyright": "Copyright © Arthur Lenancker",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "app",
        "filter": [
          "**/*",
          "!electron/**",
          "!dist/**",
          "!.git/**",
          "!.github/**",
          "!**/node_modules/**"
        ]
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../assets/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lenancker Launcher"
    }
  }
}
